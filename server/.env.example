# Server Port (matches frontend API endpoint)
PORT=8001

# MongoDB Connection String
# Use your local MongoDB or replace with your MongoDB Atlas URL:
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/hotel?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/hotel

# JWT Secret for token signing
JWT_SECRET=hotelpro_super_secret_jwt_key_2026
